# Safe for public browser use (anon key is still protected by your Supabase RLS policies)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# If Supabase provides a new sb_publishable_... key, use this INSTEAD of the anon key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://YOUR_PREVIEW_OR_PUBLIC_DOMAIN

# Server ONLY: optional but required for inviting new sub-admins by email.
# Set in Vercel environment variables. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
