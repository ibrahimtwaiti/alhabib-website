# Private Vercel Blob store (connected automatically in Vercel Storage)
BLOB_READ_WRITE_TOKEN=
# Random 32+ char server-only secret, never expose via NEXT_PUBLIC_
AUTH_SECRET=
# One-time setup code for /admin/setup; no default administrator password
ADMIN_SETUP_CODE=
# Public clinic booking WhatsApp
NEXT_PUBLIC_CLINIC_WHATSAPP=966591009916

# Neon Postgres for reliable CMS writes. Vercel injects this automatically when connected.
# Server-only: do not add NEXT_PUBLIC_ prefix.
DATABASE_URL=

# V3 preview only. Set on the Vercel version-3 preview branch (V3_PREVIEW_MODE=1).
# Without an isolated Neon branch, all CMS writes and private media uploads are disabled.
V3_PREVIEW_MODE=
# Server-only connection URL for a *different* Neon branch/compute from production.
# Do not set this equal to DATABASE_URL. Do not paste its value into this file.
V3_PREVIEW_DATABASE_URL=
# The public canonical origin for SEO (production domain).
NEXT_PUBLIC_SITE_URL=https://alhabib-website.vercel.app
